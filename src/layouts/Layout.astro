---
import '../styles/global.css'
import Footer from '../components/Footer.astro'
import Logo from '../components/Logo.astro'
import ThemeToggle from '../components/ThemeToggle.astro'

interface Props {
    title?: string
    description?: string
}

const {
    title = 'The Kalen Michael Experiment | Welcome to the Lab',
    description = 'A public log of self-trust experiments. Testing mindset, endurance, and discipline in real time. Hard proof, zero fluff.',
} = Astro.props

const MENU = [
    { id: 'experiments', label: 'EXPERIMENTS', href: '/experiments' },
    { id: 'notes', label: 'NOTES', href: '/notes' },
    { id: 'vault', label: 'VAULT', href: '/vault' },
]

const pathname = Astro.url.pathname
const active =
    pathname === '/experiments' || pathname.startsWith('/experiment/')
        ? 'experiments'
        : pathname === '/notes'
          ? 'notes'
          : pathname === '/vault'
            ? 'vault'
            : null
---

<!doctype html>
<html lang="en">
    <head>
        <meta charset="UTF-8" />
        <link rel="icon" href="/favicon.ico" sizes="32x32" />
        <link rel="icon" type="image/png" sizes="32x32" href="/favicon.png" />
        <link rel="icon" type="image/png" sizes="128x128" href="/favicon-128.png" />
        <link rel="icon" type="image/png" sizes="500x500" href="/favicon-500.png" />
        <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />
        <meta name="theme-color" content="#020617" media="(prefers-color-scheme: dark)" />
        <meta name="theme-color" content="#f8fafc" media="(prefers-color-scheme: light)" />
        <title>{title}</title>
        <meta name="description" content={description} />
        <script is:inline>
            ;(function () {
                var theme = null
                try {
                    theme = localStorage.getItem('mindset-lab-theme')
                } catch (e) {}
                if (theme !== 'light' && theme !== 'dark') {
                    theme = window.matchMedia('(prefers-color-scheme: light)').matches
                        ? 'light'
                        : 'dark'
                }
                if (theme === 'light') document.documentElement.classList.add('light')
            })()
        </script>
    </head>
    <body>
        <main class="min-h-svh bg-slate-950 font-mono text-slate-300 selection:bg-slate-300 selection:text-slate-950">
            <div class="mx-auto flex min-h-svh w-full max-w-3xl flex-col px-6 pt-8 pb-12 sm:px-8">
                <header class="border-b border-dashed border-slate-800 pb-10">
                    <div class="mb-8 flex items-center justify-between gap-4">
                        <Logo />
                        <ThemeToggle />
                    </div>
                    <nav
                        aria-label="Section"
                        class="flex flex-wrap items-center gap-1 text-xs font-bold uppercase tracking-[0.2em] text-slate-500"
                    >
                        {MENU.map((item, index) => (
                            <>
                                {index > 0 && <span class="text-slate-700">/</span>}
                                <a
                                    href={item.href}
                                    class={`px-2 transition-colors hover:text-white ${item.id === active ? 'text-white' : ''}`}
                                >
                                    {item.label}
                                </a>
                            </>
                        ))}
                    </nav>
                </header>
                <div class="flex-1">
                    <slot />
                </div>
                <Footer />
            </div>
        </main>
    </body>
</html>
