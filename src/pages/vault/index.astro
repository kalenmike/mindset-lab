---
import { getCollection } from 'astro:content'
import MoveLeftIcon from '../../components/MoveLeftIcon.astro'
import Layout from '../../layouts/Layout.astro'
import { RESOURCE_TAGS } from '../../categories'

const resources = (await getCollection('resources'))
    .map((entry) => entry.data)
    .sort((a, b) => a.no.localeCompare(b.no, undefined, { numeric: true }))
---

<Layout title="Vault // Mindset Lab">
    <nav
        slot="nav"
        aria-label="Breadcrumb"
        class="mb-8 flex flex-wrap items-center gap-1 pr-12 text-xs font-bold uppercase tracking-[0.2em] text-slate-500"
    >
        <a href="/" class="group inline-flex items-center gap-2 px-2 transition-colors hover:text-white">
            <span class="text-slate-700 transition-transform group-hover:-translate-x-1">←</span>
            MINDSET LAB
        </a>
        <span class="text-slate-700">/</span>
        <span class="px-2 text-slate-500">VAULT</span>
    </nav>

    <section class="border-b border-dashed border-slate-800 py-10">
        <p class="mb-6 text-xs text-slate-600">the archive</p>
        <h1 class="text-2xl font-bold leading-tight tracking-tight text-white sm:text-3xl">
            VAULT <span class="font-normal text-slate-600">//</span>{' '}
            <span class="text-slate-300">Resources</span>
        </h1>
        <p class="mt-6 max-w-xl text-sm leading-relaxed text-slate-400">
            A collection of resources and tools: field-tested and battle-worn.
        </p>
    </section>

    <section class="border-b border-dashed border-slate-800 py-10">
        <h2 class="flex items-center gap-3 text-xs font-bold uppercase tracking-[0.2em] text-slate-500">
            <span class="text-slate-700">##</span> All Resources
        </h2>
        <div class="mt-6">
            {resources.map((resource) => {
                const tag = RESOURCE_TAGS[resource.tag] ?? {
                    name: resource.tag,
                    desc: '',
                    color: 'text-slate-400',
                }
                return (
                    <a
                        href={resource.href}
                        class="group flex flex-col gap-2 border-b border-slate-800/70 py-5"
                    >
                        <div class="flex items-baseline gap-4 text-sm">
                            <span class="text-xs font-bold tracking-wider text-slate-600">
                                {resource.no}
                            </span>
                            <span class={`text-xs font-bold uppercase tracking-wider ${tag.color}`}>
                                [{tag.name}]
                            </span>
                        </div>
                        <span class="flex items-center gap-2 font-medium">
                            <span class="text-white transition-colors group-hover:text-slate-300">
                                {resource.title}
                            </span>
                            <MoveLeftIcon />
                        </span>
                        <span class="text-sm leading-relaxed text-slate-500">{resource.desc}</span>
                    </a>
                )
            })}
        </div>
    </section>
</Layout>