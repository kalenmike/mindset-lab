---
import { getCollection } from 'astro:content'
import Layout from '../../layouts/Layout.astro'
import MoveLeftIcon from '../../components/MoveLeftIcon.astro'
import Polaroid from '../../components/Polaroid.astro'
import { CATEGORIES, type CategoryId } from '../../categories'
import { relativeTime } from '../../lib/dates'

const entries = await getCollection('blogs')

const blogs = entries
    .filter((entry) => !entry.id.includes('/'))
    .map((entry) => {
        const name = entry.id
        const articles = entries.filter(
            (candidate) => candidate.id.includes('/') && candidate.id.startsWith(`${name}/`)
        )
        const latestPost = articles
            .map((candidate) => candidate.data.date)
            .filter((date): date is string => Boolean(date))
            .sort()
            .at(-1)
        return { name, data: entry.data, articleCount: articles.length, latestPost }
    })
    .sort((a, b) => (b.latestPost ?? '').localeCompare(a.latestPost ?? ''))

const recentArticles = entries
    .filter((entry) => entry.id.includes('/'))
    .map((entry) => {
        const [name, slug] = entry.id.split('/')
        return { name, slug, data: entry.data }
    })
    .filter((article) => Boolean(article.data.date))
    .sort((a, b) => (b.data.date ?? '').localeCompare(a.data.date ?? ''))
    .slice(0, 3)
---

<Layout title="Blog | The Kalen Michael Experiment">
    <section class="border-b border-dashed border-slate-800 py-10">
        <p class="mb-6 text-xs text-slate-600">journeys & chapters</p>
        <h1 class="text-2xl font-bold leading-tight tracking-tight text-white sm:text-3xl">
            BLOG
        </h1>
        <p class="mt-6 max-w-xl text-sm leading-relaxed text-slate-400">
            Chronicles of travel, major life pivots, and whatever else the road brings next.
        </p>
        <a
            href="/blog/rss.xml"
            class="mt-4 inline-block text-xs font-bold uppercase tracking-[0.2em] text-slate-500 transition-colors hover:text-white"
        >
            [rss] ↗
        </a>
    </section>

    <section class="border-b border-dashed border-slate-800 py-10">
        <h2 class="flex items-center gap-3 text-xs font-bold uppercase tracking-[0.2em] text-slate-500">
            <span class="text-slate-700">##</span> Recent Articles
        </h2>
        <div class="mt-6">
            {recentArticles.map((article) => {
                const category = CATEGORIES[article.data.tag as CategoryId] ?? {
                    name: article.data.tag,
                    desc: '',
                    color: 'text-slate-400',
                }
                return (
                    <a
                        href={`/blog/${article.name}/${article.slug}/`}
                        class="group flex flex-col gap-4 border-b border-slate-800/70 py-5 sm:flex-row sm:items-center"
                    >
                        {
                            article.data.thumbnail && (
                                <div class="w-44 shrink-0 sm:w-48">
                                    <Polaroid
                                        image={article.data.thumbnail}
                                        alt={article.data.title}
                                        width={185}
                                        height={104}
                                        fit="cover"
                                        compact
                                        emptyCaption
                                    />
                                </div>
                            )
                        }
                        <div class="flex flex-1 flex-col gap-2">
                            <div class="flex items-baseline gap-4 text-sm">
                                {article.data.date && (
                                    <span class="text-slate-500">{relativeTime(article.data.date)}</span>
                                )}
                                {article.data.tag && (
                                    <span
                                        class={`text-xs font-bold uppercase tracking-wider ${category.color}`}
                                    >
                                        [{category.name}]
                                    </span>
                                )}
                                <span class="text-xs text-slate-600">
                                    {article.name.replace(/-/g, ' ')}
                                </span>
                            </div>
                            <span class="flex items-center gap-2 font-medium">
                                <span class="text-white transition-colors group-hover:text-slate-300">
                                    {article.data.title}
                                </span>
                                <MoveLeftIcon />
                            </span>
                            {article.data.description && (
                                <span class="text-sm leading-relaxed text-slate-500">
                                    {article.data.description}
                                </span>
                            )}
                        </div>
                    </a>
                )
            })}
        </div>
    </section>

    <section class="border-b border-dashed border-slate-800 py-10">
        <h2 class="flex items-center gap-3 text-xs font-bold uppercase tracking-[0.2em] text-slate-500">
            <span class="text-slate-700">##</span> All Blogs
        </h2>
        <div class="mt-6">
            {blogs.map((blog) => {
                const category = CATEGORIES[blog.data.tag as CategoryId] ?? {
                    name: blog.data.tag,
                    desc: '',
                    color: 'text-slate-400',
                }
                return (
                    <a
                        href={`/blog/${blog.name}/`}
                        class="group flex flex-col gap-4 border-b border-slate-800/70 py-5 sm:flex-row sm:items-center"
                    >
                        {
                            blog.data.thumbnail && (
                                <div class="w-44 shrink-0 sm:w-48">
                                    <Polaroid
                                        image={blog.data.thumbnail}
                                        alt={blog.data.title}
                                        width={185}
                                        height={104}
                                        fit="cover"
                                        compact
                                        emptyCaption
                                    />
                                </div>
                            )
                        }
                        <div class="flex flex-1 flex-col gap-2">
                            <div class="flex items-baseline gap-4 text-sm">
                                {blog.latestPost && (
                                    <span class="text-slate-500">{relativeTime(blog.latestPost)}</span>
                                )}
                                {blog.data.tag && (
                                    <span
                                        class={`text-xs font-bold uppercase tracking-wider ${category.color}`}
                                    >
                                        [{category.name}]
                                    </span>
                                )}
                                <span class="text-xs text-slate-600">
                                    {blog.articleCount} {blog.articleCount === 1 ? 'article' : 'articles'}
                                </span>
                            </div>
                            <span class="flex items-center gap-2 font-medium">
                                <span class="text-white transition-colors group-hover:text-slate-300">
                                    {blog.data.title}
                                </span>
                                <MoveLeftIcon />
                            </span>
                            {blog.data.description && (
                                <span class="text-sm leading-relaxed text-slate-500">
                                    {blog.data.description}
                                </span>
                            )}
                        </div>
                    </a>
                )
            })}
        </div>
    </section>
</Layout>
