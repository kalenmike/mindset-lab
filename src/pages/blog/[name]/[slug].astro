---
import { getCollection, render } from 'astro:content'
import { getImage } from 'astro:assets'
import Layout from '../../../layouts/Layout.astro'
import Polaroid from '../../../components/Polaroid.astro'
import MoveLeftIcon from '../../../components/MoveLeftIcon.astro'
import MoveRightIcon from '../../../components/MoveRightIcon.astro'
import { CATEGORIES, type CategoryId } from '../../../categories'
import { formatDateTime } from '../../../lib/dates'

export async function getStaticPaths() {
    const entries = await getCollection('blogs')
    return entries
        .filter((entry) => entry.id.includes('/'))
        .map((entry) => {
            const [name, slug] = entry.id.split('/')
            return { params: { name, slug }, props: { entry } }
        })
}

const { entry } = Astro.props
const article = entry.data
const name = entry.id.split('/')[0]
const slug = entry.id.split('/')[1]
const { Content } = await render(entry)

const category = article.tag
    ? (CATEGORIES[article.tag as CategoryId] ?? { name: article.tag, color: 'text-slate-400' })
    : null

const ogImage = article.thumbnail
    ? new URL(
          (await getImage({ src: article.thumbnail, width: 640, height: 360, fit: 'cover' })).src,
          Astro.site ?? Astro.url.origin
      ).toString()
    : undefined

const entries = await getCollection('blogs')

const chrono = entries
    .filter((candidate) => candidate.id.includes('/') && candidate.id.startsWith(`${name}/`))
    .sort(
        (a, b) =>
            (a.data.order ?? 0) - (b.data.order ?? 0) ||
            (a.data.date ?? '').localeCompare(b.data.date ?? '')
    )
    .map((candidate) => ({
        slug: candidate.id.replace(`${name}/`, ''),
        data: candidate.data,
    }))

const index = chrono.findIndex((candidate) => candidate.slug === slug)
const prev = index > 0 ? chrono[index - 1] : null
const next = index >= 0 && index < chrono.length - 1 ? chrono[index + 1] : null

const blogOrder = entries
    .filter((candidate) => !candidate.id.includes('/'))
    .map((blogEntry) => {
        const latest = entries
            .filter(
                (candidate) =>
                    candidate.id.includes('/') && candidate.id.startsWith(`${blogEntry.id}/`)
            )
            .map((candidate) => candidate.data.date)
            .filter((date): date is string => Boolean(date))
            .sort()
            .at(-1)
        return { name: blogEntry.id, title: blogEntry.data.title, finished: blogEntry.data.finished, latest }
    })
    .sort((a, b) => (b.latest ?? '').localeCompare(a.latest ?? ''))

const currentBlogIndex = blogOrder.findIndex((blogEntry) => blogEntry.name === name)
const suggested =
    blogOrder.length > 1 ? blogOrder[(currentBlogIndex + 1) % blogOrder.length] : null
const suggestedDate = suggested ? (suggested.finished ?? suggested.latest) : null

const prevDate = prev ? prev.data.date : suggestedDate
const nextDate = next ? next.data.date : suggestedDate

const prevHref = prev
    ? `/blog/${name}/${prev.slug}/`
    : suggested
      ? `/blog/${suggested.name}/`
      : '/blog'
const nextHref = next
    ? `/blog/${name}/${next.slug}/`
    : suggested
      ? `/blog/${suggested.name}/`
      : '/blog'
---

<Layout
    title={`${article.title} | The Kalen Michael Experiment`}
    description={article.description}
    ogImage={ogImage}
    ogType="article"
>
    <section class="border-b border-dashed border-slate-800 py-10">
        <a
            href={`/blog/${name}/`}
            class="text-xs font-bold uppercase tracking-[0.2em] text-slate-600 transition-colors hover:text-white"
        >
            ← {name}
        </a>
        <p class="mb-6 mt-8 flex items-baseline gap-4 text-xs">
            {article.date && <span class="text-slate-600">{formatDateTime(article.date)}</span>}
            {category && (
                <span class={`font-bold uppercase tracking-wider ${category.color}`}>
                    [{category.name}]
                </span>
            )}
        </p>
        <h1 class="text-2xl font-bold leading-tight tracking-tight text-white sm:text-3xl">
            {article.title}
        </h1>
        {article.description && (
            <p class="mt-6 max-w-xl text-sm leading-relaxed text-slate-400">
                {article.description}
            </p>
        )}
        {
            article.thumbnail && (
                <div class="mt-6 w-full max-w-md">
                    <Polaroid
                        image={article.thumbnail}
                        alt={article.title}
                        width={640}
                        height={360}
                        fit="cover"
                        emptyCaption
                    />
                </div>
            )
        }
    </section>

    <section class="border-b border-dashed border-slate-800 py-10">
        <article class="blog-content max-w-xl">
            <Content />
        </article>
    </section>

    <section class="border-b border-dashed border-slate-800 py-10">
        <h2 class="flex items-center gap-3 text-xs font-bold uppercase tracking-[0.2em] text-slate-500">
            <span class="text-slate-700">##</span> Related Articles
        </h2>
        <nav class="mt-6 grid gap-4 sm:grid-cols-2">
            <a
                href={prevHref}
                class="group flex flex-col border border-dashed border-slate-800 p-5 transition-colors hover:border-slate-600"
            >
                <span class="flex items-center gap-2 text-xs font-bold uppercase tracking-[0.2em] text-slate-500 transition-colors group-hover:text-slate-300">
                    <MoveLeftIcon alwaysVisible />
                    {prev ? 'previous' : suggested ? 'another blog' : 'all blogs'}
                </span>
                <span class="mt-4 flex-1 font-medium leading-snug text-white">
                    {prev?.data.title ?? suggested?.title ?? 'Browse all blogs'}
                </span>
                <span class="mt-4 text-xs text-slate-500">
                    {prevDate ? formatDateTime(prevDate) : '—'}
                </span>
            </a>
            <a
                href={nextHref}
                class="group flex flex-col border border-dashed border-slate-800 p-5 text-right transition-colors hover:border-slate-600"
            >
                <span class="flex items-center justify-end gap-2 text-xs font-bold uppercase tracking-[0.2em] text-slate-500 transition-colors group-hover:text-slate-300">
                    {next ? 'next' : suggested ? 'another blog' : 'all blogs'}
                    <MoveRightIcon alwaysVisible />
                </span>
                <span class="mt-4 flex-1 font-medium leading-snug text-white">
                    {next?.data.title ?? suggested?.title ?? 'Browse all blogs'}
                </span>
                <span class="mt-4 text-xs text-slate-500">
                    {nextDate ? formatDateTime(nextDate) : '—'}
                </span>
            </a>
        </nav>
    </section>
</Layout>
