---
import { getCollection } from 'astro:content'
import ExperimentRow from '../../components/ExperimentRow.astro'
import Layout from '../../layouts/Layout.astro'

const experiments = (await getCollection('experiments'))
    .map((entry) => ({ slug: entry.id, ...entry.data }))
    .filter((experiment) => experiment.status !== 'HIDDEN')
    .sort((a, b) => a.order - b.order)
---

<Layout title="Experiments // Mindset Lab">
    <nav
        slot="nav"
        aria-label="Breadcrumb"
        class="mb-8 flex flex-wrap items-center gap-1 pr-12 text-xs font-bold uppercase tracking-[0.2em] text-slate-500"
    >
        <a href="/" class="group inline-flex items-center gap-2 px-2 transition-colors hover:text-white">
            <span class="text-slate-700 transition-transform group-hover:-translate-x-1">←</span>
            MINDSET LAB
        </a>
        <span class="text-slate-700">/</span>
        <span class="px-2 text-slate-500">EXPERIMENTS</span>
    </nav>

    <section class="border-b border-dashed border-slate-800 py-10">
        <p class="mb-6 text-xs text-slate-600">the archive</p>
        <h1 class="text-2xl font-bold leading-tight tracking-tight text-white sm:text-3xl">
            EXPERIMENTS <span class="font-normal text-slate-600">//</span>{' '}
            <span class="text-slate-300">Index</span>
        </h1>
        <p class="mt-6 max-w-xl text-sm leading-relaxed text-slate-400">
            Every field study, past and present — each with its own protocol and log.
        </p>
    </section>

    <section class="border-b border-dashed border-slate-800 py-10">
        <h2 class="flex items-center gap-3 text-xs font-bold uppercase tracking-[0.2em] text-slate-500">
            <span class="text-slate-700">##</span> All Experiments
        </h2>
        <div class="mt-6">
            {experiments.map((experiment) => (
                <ExperimentRow
                    slug={experiment.slug}
                    title={experiment.title}
                    subtitle={experiment.subtitle}
                    tagline={experiment.tagline}
                    status={experiment.status}
                    duration={experiment.duration}
                    tag={experiment.tag}
                />
            ))}
        </div>
    </section>
</Layout>