---
interface BlogReply {
    author: string
    date?: string
    content: string
}

interface BlogComment {
    author: string
    date?: string
    content: string
    replies?: BlogReply[]
}

interface Props {
    comments: BlogComment[]
}

const { comments } = Astro.props

const sanitize = (html: string) =>
    html
        .replace(/<script\b[^>]*>[\s\S]*?<\/script>/gi, '')
        .replace(/<style\b[^>]*>[\s\S]*?<\/style>/gi, '')
        .replace(/<iframe\b[^>]*>[\s\S]*?<\/iframe>/gi, '')
        .replace(/<object\b[^>]*>[\s\S]*?<\/object>/gi, '')
        .replace(/\son\w+\s*=\s*(?:"[^"]*"|'[^']*'|[^\s>]+)/gi, '')
        .replace(/href\s*=\s*['"]\s*javascript:[^'"]*['"]/gi, 'href="#"')
---
{comments.length > 0 && (
    <div class="mt-12 border-t border-dashed border-slate-800 pt-10">
        <h2 class="flex items-center gap-3 text-xs font-bold uppercase tracking-[0.2em] text-slate-500">
            <span class="text-slate-700">##</span> Comments
        </h2>
        <div class="mt-6 flex flex-col gap-4">
            {comments.map((comment) => (
                <div class="rounded-lg border border-parchment-200 bg-parchment-100/50 p-4">
                    <div class="flex flex-wrap items-center gap-x-3 gap-y-2">
                        <span class="inline-block border border-parchment-200 bg-parchment-100/60 px-2 py-0.5 text-[10px] font-bold uppercase tracking-[0.2em] text-slate-300">
                            {comment.author}
                        </span>
                        {comment.date && (
                            <span class="inline-block rounded-full border border-parchment-200/70 px-2 py-0.5 text-[10px] tracking-wider text-slate-500">
                                {comment.date}
                            </span>
                        )}
                    </div>
                    <div
                        class="mt-3 text-sm leading-relaxed text-slate-400"
                        set:html={sanitize(comment.content)}
                    />
                    {
                        comment.replies && comment.replies.length > 0 && (
                            <div class="mt-4 flex flex-col gap-3 border-l-2 border-dashed border-parchment-200/70 pl-4">
                                {comment.replies.map((reply) => (
                                    <div class="rounded-lg border border-parchment-200/70 bg-parchment-100/30 p-3">
                                        <div class="flex flex-wrap items-center gap-x-3 gap-y-2">
                                            <span class="inline-block border border-parchment-200 bg-parchment-100/60 px-2 py-0.5 text-[10px] font-bold uppercase tracking-[0.2em] text-slate-400">
                                                {reply.author}
                                            </span>
                                            {reply.date && (
                                                <span class="inline-block rounded-full border border-parchment-200/70 px-2 py-0.5 text-[10px] tracking-wider text-slate-600">
                                                    {reply.date}
                                                </span>
                                            )}
                                        </div>
                                        <div
                                            class="mt-2 text-sm leading-relaxed text-slate-400"
                                            set:html={sanitize(reply.content)}
                                        />
                                    </div>
                                ))}
                            </div>
                        )
                    }
                </div>
            ))}
        </div>
    </div>
)}