---
interface Props {
    alwaysVisible?: boolean
}

const { alwaysVisible = false } = Astro.props

const cls = alwaysVisible
    ? 'size-4 text-slate-500 transition-transform duration-200 group-hover:translate-x-1 group-hover:text-slate-300'
    : 'size-4 -translate-x-2 text-slate-500 opacity-0 transition-all duration-200 group-hover:translate-x-0 group-hover:text-slate-400 group-hover:opacity-100'
---

<svg
    aria-hidden="true"
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="2"
    stroke-linecap="round"
    stroke-linejoin="round"
    class={cls}
>
    <path d="M18 8 22 12 18 16" />
    <path d="M2 12h20" />
</svg>