---
interface Props {
    heading?: boolean
}

const { heading = false } = Astro.props

const wordmarkClass =
    'text-2xl font-bold leading-tight tracking-tight text-white sm:text-3xl'
---

<div>
    <p class="mb-6 text-xs text-slate-600">welcome to the experiment</p>
    {
        heading ? (
            <h1 class={wordmarkClass}>
                MINDSET LAB <span class="font-normal text-slate-600">//</span> KALEN MICHAEL
            </h1>
        ) : (
            <p class={wordmarkClass}>
                MINDSET LAB <span class="font-normal text-slate-600">//</span> KALEN MICHAEL
            </p>
        )
    }
</div>