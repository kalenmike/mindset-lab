---
import FlaskIcon from './FlaskIcon.astro'

interface Props {
    class?: string
}

const { class: className } = Astro.props
---

<a
    href="/"
    class={`group inline-flex items-center gap-2 text-xs font-bold uppercase tracking-[0.2em] text-slate-600 transition-colors hover:text-white ${className ?? ''}`}
>
    <FlaskIcon />
    MINDSET LAB <span class="font-normal text-slate-800">//</span> KALEN MICHAEL
</a>
