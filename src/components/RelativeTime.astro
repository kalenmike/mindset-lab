---
import { formatMadrid, toEpoch } from '../lib/dates'

interface Props {
    iso: string
    mode?: 'relative' | 'datetime'
}

const { iso, mode = 'relative' } = Astro.props
const epoch = toEpoch(iso)
const fallback = Number.isFinite(epoch) ? formatMadrid(epoch) : iso
---

<span
    class="relative-time"
    data-ts={Number.isFinite(epoch) ? epoch : undefined}
    data-mode={mode}
    title={Number.isFinite(epoch) ? `${formatMadrid(epoch)} (Madrid)` : undefined}
>
    {fallback}
</span>

<script>
    const rtf = new Intl.RelativeTimeFormat('en', { numeric: 'auto' })

    const datetimeFmt = new Intl.DateTimeFormat('en-US', {
        hourCycle: 'h23',
        day: '2-digit',
        month: 'short',
        year: 'numeric',
        hour: '2-digit',
        minute: '2-digit',
    })

    function relativeText(timestamp: number): string {
        const diff = timestamp - Date.now()
        const abs = Math.abs(diff)
        const minute = 60_000
        const hour = 3_600_000
        const day = 86_400_000
        let unit: Intl.RelativeTimeFormatUnit
        let value: number
        if (abs < 30_000) {
            unit = 'second'
            value = Math.round(diff / 1000)
        } else if (abs < 59.5 * minute) {
            unit = 'minute'
            value = Math.round(diff / minute)
        } else if (abs < 23.5 * hour) {
            unit = 'hour'
            value = Math.round(diff / hour)
        } else if (abs < 29.5 * day) {
            unit = 'day'
            value = Math.round(diff / day)
        } else if (abs < 11.5 * day * 30) {
            unit = 'month'
            value = Math.round(diff / (day * 30))
        } else {
            unit = 'year'
            value = Math.round(diff / (day * 365))
        }
        return rtf.format(value, unit)
    }

    function render() {
        for (const el of document.querySelectorAll<HTMLElement>('[data-ts]')) {
            const timestamp = Number(el.dataset.ts)
            if (!Number.isFinite(timestamp)) continue
            el.textContent =
                el.dataset.mode === 'datetime'
                    ? datetimeFmt.format(new Date(timestamp))
                    : relativeText(timestamp)
        }
    }

    render()
    setInterval(render, 30_000)
    document.addEventListener('visibilitychange', render)
</script>