---
interface Props {
    elsewhere?: boolean
}

const { elsewhere = true } = Astro.props

const SOCIALS = [
    { label: 'youtube', href: 'https://youtube.com/@kalenmichael' },
    { label: 'instagram', href: 'https://instagram.com/kalenmichael' },
    { label: 'tiktok', href: 'https://tiktok.com/@kalenmichael' },
    { label: 'x', href: 'https://x.com/kalenmichael' },
]
---

{
    elsewhere && (
        <section id="elsewhere" class="border-b border-dashed border-slate-800 py-10">
            <h2 class="flex items-center gap-3 text-xs font-bold uppercase tracking-[0.2em] text-slate-500">
                <span class="text-slate-700">##</span> Elsewhere
            </h2>
            <div class="flex flex-wrap gap-x-10 gap-y-4 pt-6">
                {SOCIALS.map((social) => (
                    <a
                        href={social.href}
                        target="_blank"
                        rel="noreferrer"
                        class="group flex items-center gap-2 text-sm text-slate-400 transition-colors hover:text-white"
                    >
                        <span class="text-slate-700 group-hover:text-slate-400">↗</span>
                        {social.label} <span class="text-slate-600">/@kalenmichael</span>
                    </a>
                ))}
            </div>
        </section>
    )
}
<footer class="mt-auto border-t border-dashed border-slate-800 pt-6 text-xs text-slate-600">
    mindset lab // kalen michael — rebuilt daily.
</footer>